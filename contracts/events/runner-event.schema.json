{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://synch.local/contracts/events/runner-event/2.0.3",
 "title": "Synch runner-local journal event v2.0.2",
 "description": "Spec 'Remote execution' (a remote runner owns the process and stores numbered events), decision 15. Written by a runner to its local journal before it acknowledges anything. Has no global_seq/recorded_at: only the daemon assigns those on ingest (catalogue.md section 3). Payload must satisfy the catalogue payload schema for (type, type_version). The runner validates (type, type_version, payload) against these catalogue payload schemas BEFORE acknowledging a record, so every acknowledged record is ingestible.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "runner_event_version",
  "runner",
  "source_seq",
  "id",
  "type",
  "type_version",
  "occurred_at",
  "thread_id",
  "payload"
 ],
 "properties": {
  "runner_event_version": {
   "const": 2
  },
  "runner": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._-]{1,64}$",
   "description": "Registered runner ID; the daemon checks it matches the authenticated runner connection."
  },
  "source_seq": {
   "type": "integer",
   "minimum": 1,
   "description": "Per-runner sequence, starts at 1, contiguous, never reused (survives runner restart)."
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
  },
  "type": {
   "enum": [
    "engine.output",
    "engine.usage",
    "engine.capability_unavailable",
    "process.exited",
    "check.result",
    "policy.decided"
   ],
   "description": "Only facts a runner can observe locally. State transitions, approvals and grants are daemon-only."
  },
  "type_version": {
   "type": "integer",
   "minimum": 1
  },
  "occurred_at": {
   "type": "string",
   "format": "date-time"
  },
  "thread_id": {
   "type": "string",
   "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
  },
  "redactions": {
   "type": "integer",
   "minimum": 0
  },
  "payload": {
   "type": "object"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "type": {
      "const": "engine.output"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "properties": {
     "type_version": {
      "const": 1
     },
     "payload": {
      "$ref": "https://synch.local/contracts/events/catalogue/4.2.0#/$defs/e_engine_output/properties/payload"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "engine.usage"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "properties": {
     "type_version": {
      "const": 1
     },
     "payload": {
      "$ref": "https://synch.local/contracts/events/catalogue/4.2.0#/$defs/e_engine_usage/properties/payload"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "engine.capability_unavailable"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "properties": {
     "type_version": {
      "const": 1
     },
     "payload": {
      "$ref": "https://synch.local/contracts/events/catalogue/4.2.0#/$defs/e_engine_capability_unavailable/properties/payload"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "process.exited"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "properties": {
     "type_version": {
      "const": 1
     },
     "payload": {
      "$ref": "https://synch.local/contracts/events/catalogue/4.2.0#/$defs/e_process_exited/properties/payload"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "check.result"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "properties": {
     "type_version": {
      "const": 1
     },
     "payload": {
      "$ref": "https://synch.local/contracts/events/catalogue/4.2.0#/$defs/e_check_result/properties/payload"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "policy.decided"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "properties": {
     "type_version": {
      "const": 2
     },
     "payload": {
      "$ref": "https://synch.local/contracts/events/catalogue/4.2.0#/$defs/e_policy_decided/properties/payload"
     }
    }
   }
  }
 ]
}
